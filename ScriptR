# https://www.kaggle.com/datasets/levyedgar44/income-and-happiness-correction?select=happyscore_income.csv
setwd("~/Documents")
dataset <- read.csv("happyscore_income.csv")
install.packages("aplpack")
library("aplpack")

bagplot(dataset$avg_income, dataset$avg_satisfaction, factor = 3,   
        show.outlier = TRUE, show.whiskers = FALSE, 
        show.looppoints = TRUE, show.bagpoints = TRUE,
        show.loophull = TRUE, show.baghull = TRUE, 
        create.plot = TRUE, add = FALSE, pch = 20, cex = 0.4, 
        dkmethod = 2, precision = 1, verbose = FALSE, 
        debug.plots = "no",   col.loophull="#00ccff", 
        col.looppoints="#2244ff", col.baghull="#7799ff", 
        col.bagpoints="#000088", transparency=FALSE, 
        show.center = TRUE
)
